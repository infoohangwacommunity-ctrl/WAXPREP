# Wax Prep configuration.
# Never put real secrets in Git.

# DATABASE_URL=postgresql://waxprep:waxprep@localhost:5432/waxprep_test

# Encryption keys for student data: "id:base64(32 random bytes)[,id:...]".
# Generate one with: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
# WAXPREP_MASTER_KEYS=
# WAXPREP_ACTIVE_KEY_ID=

# Main model + document parse (Upstage)
# UPSTAGE_API_KEY=
# UPSTAGE_BASE_URL=https://api.upstage.ai/v1
# UPSTAGE_DOCUMENT_MODEL=document-parse

# Optional voice transcription only (not a Teacher). Explicit choice:
# WAXPREP_VOICE_PROVIDER=gemini
# GEMINI_API_KEY=
# — or —
# WAXPREP_VOICE_PROVIDER=grok
# XAI_API_KEY=

# Media limits
# WAXPREP_MAX_INBOUND_BYTES=15728640
# WAXPREP_MAX_AUDIO_BYTES=10485760
# WAXPREP_MAX_AUDIO_SECONDS=600
# WAXPREP_MEDIA_TIMEOUT=60
# WAXPREP_BLOB_ROOT=.waxprep-blobs

# WhatsApp Cloud API (disabled unless WAXPREP_WHATSAPP_ENABLED=true)
# WAXPREP_WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WAXPREP_PUBLIC_BASE_URL=https://example.com
